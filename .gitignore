bin
mods
storage
storage_*
mpmissions/*/storage_*/
*.log
*.txt
*.RPT
*.mdmp
profiles/BattlEye
profiles/DataCache/*
# Runtime state under profiles/. The mod and server settings there stay tracked;
# only what the engine rewrites is ignored. Mod logs need no rule of their own,
# *.log and *.txt above already cover them.
# Per client profile defaults, generated by the engine. "users" and "Users" are
# the same folder on a case insensitive filesystem, so both spellings are listed.
profiles/[Uu]sers/
# Live persistence: quest progress, per player quest/hardline data, and the
# bunker loot inventory state the mission keeps outside of storage_<instanceId>.
profiles/ExpansionMod/Quests/PersistentServerData.json
profiles/ExpansionMod/Quests/GroupData/
profiles/ExpansionMod/Quests/PlayerData/
profiles/ExpansionMod/Hardline/PlayerData/
profiles/BlackSector_BunkerLoot/BlackSector_BunkerLootState.json
# VPPAdminTools admin password, written by the mod on first run.
profiles/VPPAdminTools/Permissions/credentials.txt
# Per-instance config, created by copying the checked-in *.example templates.
config/server.ini
config/*.conf
config/*.cfg
